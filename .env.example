# Public-domain packs (KJV / ASV / WEB) work with no keys.

# ESV via Crossway (https://api.esv.org/)
ESV_API_KEY=

# NIV + NKJV via API.Bible / scripture.api.bible
API_BIBLE_KEY=

# Optional: override Bible ids from your API.Bible account
# API_BIBLE_NIV_ID=78a9f6124f344018-01
# API_BIBLE_NKJV_ID=de4e12af7f28f599-02
